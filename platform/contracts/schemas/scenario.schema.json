{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BestNathan/ntarlink/blob/main/platform/contracts/schemas/scenario.schema.json",
  "title": "ntarlink deterministic packet simulation scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "duration_ns",
    "control_delay_ns",
    "nodes",
    "links",
    "flows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "duration_ns": {
      "type": "integer",
      "minimum": 1
    },
    "control_delay_ns": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fault"
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contact"
      }
    },
    "contact_mode": {
      "type": "string",
      "enum": [
        "static",
        "scheduled"
      ],
      "description": "Static: unspecified orbital links remain available; scheduled: orbital links need a contact window to be usable."
    },
    "optical_head_outages": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/optical_head_outage"},
      "description": "SYS-02 half-open head unavailability windows, only for configured optical_pat heads."
    },
    "optical_pat": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/optical_pat_link"
      },
      "description": "Opt-in exclusive-head PAT acquisition for scheduled geometric optical ISL contacts."
    },
    "access_beams": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/access_beam"
      },
      "description": "Optional shared uplink MAC beam resources. Unlisted user RF links keep legacy independent transport."
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "terminal",
            "satellite",
            "ground_station",
            "pop",
            "internet"
          ]
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "capacity_bps",
        "propagation_delay_ns",
        "queue_limit_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "user_rf",
            "optical_isl",
            "feeder",
            "backhaul",
            "internet"
          ]
        },
        "capacity_bps": {
          "type": "integer",
          "minimum": 1
        },
        "propagation_delay_ns": {
          "type": "integer",
          "minimum": 0
        },
        "processing_delay_ns": {
          "type": "integer",
          "minimum": 0
        },
        "queue_limit_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "up": {
          "type": "boolean"
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "destination",
        "packet_size_bytes",
        "packet_count",
        "start_ns",
        "interval_ns"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "packet_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "packet_count": {
          "type": "integer",
          "minimum": 1
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "interval_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_ns",
        "link_id",
        "action"
      ],
      "properties": {
        "at_ns": {
          "type": "integer",
          "minimum": 0
        },
        "link_id": {
          "type": "string"
        },
        "action": {
          "enum": [
            "down",
            "up"
          ]
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "start_ns",
        "end_ns"
      ],
      "properties": {
        "link_id": {
          "type": "string",
          "minLength": 1
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 1
        },
        "propagation_delay_ns": {
          "type": "integer",
          "minimum": 1
        },
        "propagation_delay_samples": {
          "type": "array",
          "maxItems": 500000,
          "items": {
            "$ref": "#/$defs/delay_sample"
          },
          "description": "Optional ordered, positive delay samples spanning [start_ns, end_ns); Rust validates first/last timestamps, monotonicity, and total budget. Interpolated at TX completion; propagation_delay_ns remains routing weight."
        }
      }
    },
    "delay_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at_ns",
        "delay_ns"
      ],
      "properties": {
        "at_ns": {
          "type": "integer",
          "minimum": 0,
          "description": "Scenario-relative virtual time in nanoseconds."
        },
        "delay_ns": {
          "type": "integer",
          "minimum": 1,
          "description": "One-way geometric propagation delay in nanoseconds."
        }
      }
    },
    "optical_head_outage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_id", "start_ns", "end_ns"],
      "properties": {
        "head_id": {"type": "string", "minLength": 1},
        "start_ns": {"type": "integer", "minimum": 0},
        "end_ns": {"type": "integer", "minimum": 1}
      }
    },
    "optical_pat_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "from_head", "to_head", "slew_ns", "acquisition_ns"],
      "properties": {
        "link_id": {"type": "string", "minLength": 1},
        "from_head": {"type": "string", "minLength": 1},
        "to_head": {"type": "string", "minLength": 1},
        "slew_ns": {"type": "integer", "minimum": 0},
        "acquisition_ns": {"type": "integer", "minimum": 1}
      }
    },
    "access_beam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capacity_bps",
        "frame_duration_ns",
        "quantum_bytes",
        "packet_overhead_bytes",
        "queue_limit_bytes",
        "bearers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "capacity_bps": {
          "type": "integer",
          "minimum": 1
        },
        "frame_duration_ns": {
          "type": "integer",
          "minimum": 1
        },
        "quantum_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "packet_overhead_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "queue_limit_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "bearers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/beam_bearer"
          }
        }
      }
    },
    "beam_bearer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminal_id",
        "link_id",
        "weight"
      ],
      "properties": {
        "terminal_id": {
          "type": "string",
          "minLength": 1
        },
        "link_id": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
